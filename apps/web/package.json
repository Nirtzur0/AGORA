{
  "name": "@agora/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "smoke:artifact-viewer": "node scripts/smoke_artifact_viewer.mjs",
    "smoke:artifact-viewer:chromium": "AGORA_SMOKE_BROWSER=chromium node scripts/smoke_artifact_viewer.mjs",
    "smoke:artifact-viewer:firefox": "AGORA_SMOKE_BROWSER=firefox node scripts/smoke_artifact_viewer.mjs",
    "smoke:artifact-viewer:webkit": "AGORA_SMOKE_BROWSER=webkit node scripts/smoke_artifact_viewer.mjs",
    "smoke:artifact-viewer:matrix": "npm run smoke:artifact-viewer:chromium && npm run smoke:artifact-viewer:firefox && npm run smoke:artifact-viewer:webkit",
    "smoke:artifact-viewer:mobile": "AGORA_SMOKE_BROWSER=chromium AGORA_SMOKE_VIEWPORT=mobile node scripts/smoke_artifact_viewer.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "playwright": "^1.58.2",
    "vite": "^5.0.8"
  }
}
