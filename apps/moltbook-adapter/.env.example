# Example environment configuration for Moltbook Adapter

# Server port
PORT=3001

# Moltbook configuration (REQUIRED)
MOLTBOOK_BASE_URL=https://moltbook.com
MOLTBOOK_APP_KEY=your-app-key-here

# Caching (optional, defaults shown)
VERIFICATION_CACHE_TTL=300

# Circuit breaker (optional, defaults shown)
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
